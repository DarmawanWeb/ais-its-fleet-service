# ais-its-fleet-service — every variable the service reads (docs/PLATFORM_SPEC.md §4, §13.3).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=fleet
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "fleet" ---------------------
DATABASE_URL=postgres://fleet_svc:fleet_svc@localhost:5432/aisits
DATABASE_SCHEMA=fleet
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream (this service produces the FLEET stream) -----------------------
# Comma separated list allowed.
NATS_URL=nats://localhost:4222
# Prefix of durable consumer names (empty in deployments; the service has no durable consumers).
NATS_DURABLE_PREFIX=

# --- Valkey (not used by this service; kept for the common schema) ---------------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey; none in this service).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
# Browser origins allowed by CORS. Exposed response headers: X-Request-Id, Retry-After,
# WWW-Authenticate, ETag, Location (the kit's defaults; this service adds none).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-For is trusted (IPs, CIDRs, loopback/linklocal/uniquelocal).
# Production: the gateway's address or CIDR ONLY (spec §4), e.g. TRUSTED_PROXIES=10.42.0.0/16;
# the default trusts every private network, so any host inside it could choose the client IP
# that audit records store, and the service logs a warning at boot while it is in effect.
# TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# --- Tracing (OTLP/HTTP traces only; disabled when unset) ---------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# --- Object storage for vessel photos (S3 / RustFS in dev, spec §13.3) -------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Development credentials of the compose RustFS; refused when NODE_ENV=production.
S3_ACCESS_KEY=aisits-dev
S3_SECRET_KEY=aisits-dev-secret
# Created at startup when missing.
S3_BUCKET_PHOTOS=vessel-photos
# Path-style URLs (http://host/bucket/key), required by RustFS/MinIO.
S3_FORCE_PATH_STYLE=true
# Host browsers reach the bucket on: presigned photo URLs are signed for it (default S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- VesselSnapshotV1 publication (transactional outbox → FLEET stream) ------------
# The kit's outbox relay in per-key mode: every replica relays, the rows of one vessel in
# order; a failing row backs off on its own and only its vessel waits.
# Re-enqueue the snapshot of every vessel at startup (rebuilds a lost/purged FLEET stream).
FLEET_REPUBLISH_ON_BOOT=false
# Idle polling interval of the outbox relay, ms (commits also wake it immediately).
OUTBOX_POLL_INTERVAL_MS=500
# Rows claimed (FOR UPDATE SKIP LOCKED) per relay pass; all their vessels are published at
# once, so a NATS outage holds a pass for one 10 s JetStream request timeout.
OUTBOX_BATCH_SIZE=100
# Upper bound of the per-row retry backoff (equal-jitter exponential from 1 s), ms.
OUTBOX_MAX_BACKOFF_MS=60000
# How long published rows stay in fleet.outbox, hours.
OUTBOX_RETENTION_HOURS=24
